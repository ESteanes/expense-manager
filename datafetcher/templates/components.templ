package templates

import (
    "github.com/esteanes/up-bank-go/datafetcher/models"
    "strconv"
    "time"
)

templ AlertBanner(alerts <-chan models.ProviderAlert) {
	for alert := range alerts {
		@templ.Flush() {
			<div class="mx-8 mt-4 p-4 bg-amber-100 border border-amber-400 text-amber-800 rounded-lg flex items-center" role="alert">
				<svg class="w-5 h-5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
					<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
				</svg>
				<span><strong>{ alert.Provider }:</strong> { alert.Message }</span>
			</div>
		}
	}
}
templ TimeComponent(d time.Time) {
	<div>{ d.String() }</div>
}

templ NotFoundComponent() {
	<div>404 - Not found</div>
}


templ counts(global, user int) {
	<div>Global: { strconv.Itoa(global) }</div>
	<div>User: { strconv.Itoa(user) }</div>
}

templ form() {
	<form action="/counter" method="POST">
		<div><button type="submit" name="global" value="global">Global</button></div>
		<div><button type="submit" name="user" value="user">User</button></div>
	</form>
}

templ Page(global, user int) {
	@counts(global, user)
	@form()
}